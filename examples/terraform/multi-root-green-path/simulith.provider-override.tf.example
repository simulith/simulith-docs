# Gitignored Simulith overlay — copy to validator root as simulith_override.tf (not committed in simulith or validator repos).
# Merges with the existing provider "aws" block; bootstrap root only (no remote_state in this module).
provider "aws" {
  access_key                  = "test"
  secret_key                  = "secret"
  skip_credentials_validation = true
  skip_metadata_api_check     = true
  skip_requesting_account_id  = true
  s3_use_path_style           = true

  endpoints {
    s3       = "http://127.0.0.1.sslip.io:4566"
    dynamodb = "http://127.0.0.1.sslip.io:4566"
  }
}
