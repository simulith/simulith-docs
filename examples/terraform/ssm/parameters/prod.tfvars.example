# Real AWS prod — copy to prod.tfvars
#   terraform workspace select aws
#   terraform apply -var-file=prod.tfvars -parallelism=1
#
# Set secrets via TF_VAR_* or a gitignored prod.tfvars (never commit real values).
env                   = "PROD"
project_name          = "demoapp"
use_simulith_endpoint = false
use_remote_state      = true
aws_region            = "us-east-1"

account_id = "000000000000"
algorithm  = "HS512"
api_key    = "DEMO"
domain     = "prod.demoapp.example"
endpoint   = "https://dynamodb.us-east-1.amazonaws.com"
region     = "us-east-1"
