# Simulith local — copy to terraform.tfvars or: terraform apply -var-file=terraform.tfvars.example
#
# Docker all-in-one (Console on :9080, runtime NOT on host :4566 by default):
#   docker compose -f docker-compose.all-in-one.yml up --build
#   → use simulith_endpoint below (same backend as Console DynamoDB panel)
#
# Native / docker-compose with :4566 published on host:
#   go run ./cmd/simulith start
#   or: docker compose -f docker-compose.all-in-one.yml -f docker-compose.all-in-one.runtime-port.yml up
#   → use terraform.tfvars.native.example instead
project_name          = "loyaleasy"
environment           = "dev"
use_simulith_endpoint = true
simulith_endpoint     = "http://127.0.0.1:9080/runtime"
aws_region            = "us-east-1"
