# Simulith local — copy to dev.tfvars (workspace default; NOT real AWS)
#   terraform workspace select default
#   terraform apply -var-file=dev.tfvars -parallelism=1
env                   = "DEV"
project_name          = "simulith"
use_simulith_endpoint = true
simulith_endpoint     = "http://127.0.0.1:9080/runtime"
use_remote_state      = false
aws_region            = "us-east-1"

account_id = "000000000000"
algorithm  = "HS512"
api_key    = "LOYALTY"
domain     = "dev.localhost"
endpoint   = "http://127.0.0.1:9080/runtime"
region     = "us-east-1"

access_key_id     = "AKIALOCALDEMOKEY"
secret_access_key = "local-demo-secret-access-key"
secret_password   = "local-demo-secret-password"
