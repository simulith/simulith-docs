# Gitignored Simulith overlay for validator cognito/ (Cognito + Lambda + IAM + S3 backend surfaces).
provider "aws" {
  access_key                  = "test"
  secret_key                  = "secret"
  skip_credentials_validation = true
  skip_metadata_api_check     = true
  skip_requesting_account_id  = true
  s3_use_path_style           = true

  endpoints {
    s3         = "http://127.0.0.1.sslip.io:4566"
    dynamodb   = "http://127.0.0.1.sslip.io:4566"
    cognitoidp = "http://127.0.0.1.sslip.io:4566"
    lambda     = "http://127.0.0.1.sslip.io:4566"
    iam        = "http://127.0.0.1.sslip.io:4566"
    sts        = "http://127.0.0.1.sslip.io:4566"
  }
}
