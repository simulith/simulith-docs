# Optional: read parameters under a path prefix.
#
# **Shipped in the parameters module:** see [`parameters/path-data.tf`](parameters/path-data.tf)
# and outputs `parameters_by_path_names` / `parameters_by_path_count`.
#
# Minimal demo (/app/demo from seed):
# 1. Run: simulith seed
# 2. Copy this file to path-data.tf in runtime/examples/terraform/ssm/ (root module)
# 3. terraform init && terraform apply

data "aws_ssm_parameters_by_path" "demo" {
  path      = "/app/demo"
  recursive = true
}

output "demo_parameter_names" {
  description = "Names under /app/demo from seed (and any other matches)"
  value       = data.aws_ssm_parameters_by_path.demo.names
}
